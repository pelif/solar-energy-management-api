                                "schema": {
                                    "properties": {
                                        "id": {
                                            "type": "string",
                                            "format": "uuid"
                                        },
                                        "client_id": {
                                            "type": "string",
                                            "format": "uuid"
                                        },
                                        "uf": {
                                            "type": "string"
                                        },
                                        "installation_type": {
                                            "type": "string"
                                        },
                                        "equipment": {
                                            "type": "array",
